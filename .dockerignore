# Docker build context whitelist. Keep identical to .railwayignore.
*
!Dockerfile.railway
!Dockerfile.backup
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.base.json
!tsconfig.json
!artifacts/
!artifacts/**
!lib/
!lib/**
!scripts/
!scripts/**
!docs/
!docs/**
!services/
!services/**
!.release-commit
**/node_modules
**/dist
**/.env
**/.env.*
**/*.log
.tmp
