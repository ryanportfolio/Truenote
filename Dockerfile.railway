# Railway image for both services. TRUENOTE_PROCESS picks the process:
#   web    → api-server serving /api and the built SPA (default)
#   worker → pg-boss ingestion and evaluation worker
# Debian (glibc) base: @node-rs/argon2 ships a glibc prebuilt binary.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true \
    npm_config_store_dir=/pnpm/store
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r run check \
 && pnpm --filter @workspace/rag-app run build

FROM node:22-bookworm-slim
WORKDIR /app
# The runtime runs TypeScript through tsx, a dev dependency: never prune dev dependencies.
ENV NODE_ENV=production \
    API_PORT=8080
# Root keeps ownership of /app, so the node user can read and run the code
# but cannot change it. Nothing writes under /app at runtime: uploads go to
# object storage and tsx caches in /tmp.
COPY --from=build /app /app
USER node
EXPOSE 8080
CMD ["sh", "/app/scripts/railway-start.sh"]
