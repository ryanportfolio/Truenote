# Railway image for both services. TRUENOTE_PROCESS picks the process:
#   web    → api-server serving /api and the built SPA (default)
#   worker → pg-boss ingestion and evaluation worker
# Debian (glibc) base: @node-rs/argon2 ships a glibc prebuilt binary.
# Pulled from mirror.gcr.io, Google's copy of Docker Hub's official images:
# Railway's shared builders pull Docker Hub anonymously and hit its per-IP
# limit (429 Too Many Requests, 2026-10-09). The digest equals Docker Hub's
# for the same tag; Dependabot (docker ecosystem) proposes updates.
FROM mirror.gcr.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
WORKDIR /app
ENV CI=true \
    npm_config_store_dir=/pnpm/store
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r run check \
 && pnpm --filter @workspace/rag-app run build

FROM mirror.gcr.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /app
# The runtime runs TypeScript through tsx, a dev dependency: never prune dev dependencies.
ENV NODE_ENV=production \
    API_PORT=8080
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 8080
CMD ["sh", "/app/scripts/railway-start.sh"]
